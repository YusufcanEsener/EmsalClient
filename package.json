{
  "name": "emsalclient",
  "version": "1.0.12",
  "description": "EmsalClient — Minecraft AFK & Ada Otomasyon İstemcisi",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/suite.test.js",
    "bot-only": "node main.js",
    "build": "electron-builder --win portable",
    "dist": "electron-builder"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "minion",
    "afk",
    "electron",
    "emsalclient"
  ],
  "author": "EmsalSiz",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "semver": "^7.8.5",
    "vec3": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YusufcanEsener/EmsalClient.git"
  },
  "build": {
    "appId": "com.emsalsiz.emsalclient",
    "productName": "EmsalClient",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YusufcanEsener",
        "repo": "EmsalClient",
        "releaseType": "release"
      }
    ],
    "files": [
      "electron-main.js",
      "main.js",
      "preload.js",
      "releases.json",
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EmsalClient"
    },
    "portable": {
      "artifactName": "${productName}.exe"
    }
  }
}
